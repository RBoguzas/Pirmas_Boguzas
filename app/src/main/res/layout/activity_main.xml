<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Teksto elementas -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Labas"
        android:textSize="22sp"
        android:layout_marginBottom="40dp" />

    <!-- 1 Mygtukas: Teksto keitimas (su grįžimu į "Labas") -->
    <Button
        android:id="@+id/buttonPaspausk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paspausk"
        android:layout_marginBottom="16dp" />

    <!-- 2 Mygtukas: Teksto spalvos keitimas -->
    <Button
        android:id="@+id/buttonSpalva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pakeisk teksto spalvą"
        android:layout_marginBottom="16dp" />

    <!-- 3 Mygtukas: Atstatymas i pradinę būseną -->
    <Button
        android:id="@+id/buttonAtstatyk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atstatyk" />

</LinearLayout>